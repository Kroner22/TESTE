# Omega Predictions — Production Environment Template
# Copie este arquivo como .env e preencha as variáveis

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=<gerar-uma-chave-aleatoria-64-char>
PROJECT_NAME=Omega Predictions
VERSION=0.1.0

# Runtime Mode: SIMULATION | HYBRID | REAL_MARKET
RUNTIME_MODE=HYBRID

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
MAX_CONNECTIONS=1000

# Database (SQLite para MVP, PostgreSQL depois)
DATABASE_URL=sqlite:///./data/omega.db
# DATABASE_URL=postgresql://omega:<senha>@localhost:5432/omega_pred

# Redis (para cache + fila de alertas)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=30

# Segurança
JWT_SECRET=<gerar-jwt-secret-64-char>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=https://omegapredictions.com.br,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE=3
RATE_LIMIT_PRO=300
RATE_LIMIT_ELITE=1000

# Stripe (pagamentos)
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PRICE_FREE=price_free_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_ELITE=price_elite_id

# TheOddsAPI (já configurada)
THE_ODDS_API_KEY=bfc4d4fd8885a0fd5a4150a3513449f1

# Opcionais (bookmakers reais)
PINNACLE_API_KEY=
PINNACLE_API_SECRET=
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=<bot-token>

# WhatsApp
WHATSAPP_API_KEY=

# Scanner
SCAN_INTERVAL=5
SCAN_MIN_PROFIT=0.5
OVERROUND_METHOD=BASIC
KELLY_FRACTION=0.5
MAX_SINGLE_BET_PCT=25

# Email (para notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@omegapredictions.com.br

# Logging
LOG_LEVEL=info
STRUCTLOG_LOG_LEVEL=info

# OpenTelemetry (opcional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=omega-predictions
