# ============================================================
# Omega Predictions — Production Environment Configuration
# ============================================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string-in-production
PROJECT_NAME=Omega Predictions
VERSION=1.0.0
DOMAIN=https://omega-predictions.com

# Runtime
RUNTIME_MODE=HYBRID

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS (frontend domain)
CORS_ORIGINS=https://omega-predictions.com

# Database (SQLite for MVP, PostgreSQL for scale)
MVP_DB_PATH=data/mvp.db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# Observability
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_monthly_price_id

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Background Tasks
SCAN_ENABLED=true
SCAN_INTERVAL_SECONDS=30.0
SCAN_TOTAL_STAKE=100
SCAN_MIN_PROFIT_PCT=0.005

# External APIs (optional)
THE_ODDS_API_KEY=
PINNACLE_API_KEY=
PINNACLE_API_SECRET=
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
