# ─── Sports Quant Platform ───────────────────────────────────────
# All configurable via environment variables
# Copy this to .env and fill in values

# ── General ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
PROJECT_NAME=Sports Quant Platform
VERSION=0.1.0

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
MAX_CONNECTIONS=1000
BACKLOG=2048
KEEPALIVE=5
TIMEOUT=30
GRACEFUL_TIMEOUT=30
LIMIT_MAX_REQUESTS=10000

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_SENTINEL_URL=
REDIS_SENTINEL_MASTER=mymaster
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=2.0

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRATEGY=sliding_window  # sliding_window | token_bucket | fixed_window
RATE_LIMIT_DEFAULT=100              # requests per window
RATE_LIMIT_WINDOW=60                # window in seconds
RATE_LIMIT_BURST=200                # burst allowance
RATE_LIMIT_WS_PER_CONNECTION=20     # ws messages/sec per connection
RATE_LIMIT_WS_GLOBAL=500            # ws messages/sec globally

# ── Background Tasks ─────────────────────────────────────────────
SCAN_ENABLED=true
SCAN_INTERVAL_SECONDS=5.0
SCAN_TOTAL_STAKE=100
SCAN_MIN_PROFIT_PCT=0.005
SCAN_MAX_CONCURRENCY=4

# ── Observability ────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_EXPORTER=console  # console | otlp
OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | console
LOG_INCLUDE_TRACE_ID=true

# ── Resilience ───────────────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX=3
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=30.0
BULKHEAD_MAX_CONCURRENT=20
BULKHEAD_MAX_QUEUE=50
TIMEOUT_DEFAULT=10.0
TIMEOUT_HEAVY=60.0

# ── Cache ────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=30
CACHE_MAX_SIZE_MB=512
CACHE_KEY_PREFIX=sq:

# ── WebSocket ────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CLIENTS=10000
WS_MAX_BACKPRESSURE=128
WS_MESSAGE_QUEUE_SIZE=256

# ── Database (future) ────────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ── External Integrations ────────────────────────────────────────
BOOKMAKER_API_KEYS=
BOOKMAKER_REQUEST_TIMEOUT=5.0
BOOKMAKER_MAX_RETRIES=3
BOOKMAKER_CACHE_TTL=15
