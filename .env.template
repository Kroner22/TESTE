# Sports Quant Platform — Environment Configuration
# ==================================================
# Copy this file to .env and fill in your API keys.
# cp .env.template .env

# ── Runtime Mode ─────────────────────────────────────
# Controls which data sources are active:
#   SIMULATION    — fallback only (no real API calls)
#   HYBRID        — real + fallback (data tagged by source)
#   REAL_MARKET   — real providers only (no simulation)
# Default: SIMULATION (changes only when API keys are set)
RUNTIME_MODE=SIMULATION

# ── The Odds API (TIER 1 — Primary) ──────────────────
# Get your free API key at https://the-odds-api.com/
# Free tier: 500 requests/month
# Sports: soccer, basketball, tennis, americanfootball, baseball, icehockey, mma
THE_ODDS_API_KEY=your_api_key_here

# ── Pinnacle API (TIER 1 — Sharp Market Reference) ───
# Register at https://pinnacleapi.com/
# Provides sharp odds used as market truth reference
PINNACLE_API_KEY=your_pinnacle_api_key_here
PINNACLE_API_SECRET=your_pinnacle_api_secret_here

# ── Betfair Exchange (TIER 1 — Market Truth Source) ──
# Register at https://developer.betfair.com/
# Requires: App Key, Username, Password
# Production access requires certificates
# Non-production (delayed) access available without certs
BETFAIR_APP_KEY=your_app_key_here
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password
# Path to .p12 certificate file (production only)
BETFAIR_CERT_PATH=

# ── Betano (TIER 2 — Soft Bookmaker) ────────────────
# Uses The Odds API as data source (Betano is supported there)
# No separate API key needed — uses THE_ODDS_API_KEY

# ── Scanner Settings ──────────────────────────────────
SCAN_ENABLED=true
SCAN_INTERVAL_SECONDS=5.0
SCAN_TOTAL_STAKE=100
SCAN_MIN_PROFIT_PCT=0.005

# ── Provider Settings ────────────────────────────────
PRIMARY_UPDATE_INTERVAL=30.0
SECONDARY_UPDATE_INTERVAL=45.0
PINNACLE_UPDATE_INTERVAL=15.0
BETFAIR_UPDATE_INTERVAL=10.0
BETANO_UPDATE_INTERVAL=60.0
FALLBACK_UPDATE_INTERVAL=5.0

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# ── Observability ────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true
